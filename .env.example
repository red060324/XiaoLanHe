# Local Compose example. Production uses the same bounded options plus tls=xlh-verified.
XLH_DATABASE_URL='xlh:replace-me@tcp(127.0.0.1:3306)/xiaolanhe?parseTime=true&loc=UTC&charset=utf8mb4&timeout=5s&readTimeout=5s&writeTimeout=5s&multiStatements=false&clientFoundRows=false'
XLH_MYSQL_DATABASE=xiaolanhe
XLH_MYSQL_USER=xlh
XLH_MYSQL_PASSWORD=replace-me
# Local Compose only. Production must set false and configure the xlh-verified profile below.
XLH_DATABASE_ALLOW_INSECURE=true
XLH_DATABASE_TLS_CA_FILE=
XLH_DATABASE_TLS_SERVER_NAME=
# Optional mutual TLS. Set both or neither.
XLH_DATABASE_TLS_CERT_FILE=
XLH_DATABASE_TLS_KEY_FILE=
XLH_DATABASE_MAX_OPEN_CONNECTIONS=25
XLH_DATABASE_MAX_IDLE_CONNECTIONS=10
XLH_DATABASE_CONNECTION_MAX_LIFETIME=30m
XLH_DATABASE_CONNECTION_MAX_IDLE_TIME=5m
XLH_DATABASE_MIGRATION_LOCK_TIMEOUT=30s
XLH_AI_API_KEY=replace-me
XLH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_AI_CHAT_MODEL=qwen3.5-flash
XLH_PUBLIC_ORIGIN=http://localhost:5173
XLH_COOKIE_SECURE=false
# Required with advanced AI or flash sale; use a distinct 32+ character operator secret.
XLH_METRICS_TOKEN=replace-with-a-distinct-32-character-operator-secret
XLH_SEARCH_ENABLED=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
XLH_RESEARCH_TIMEOUT=25s
XLH_RESEARCH_TOOL_TIMEOUT=10s
XLH_RESEARCH_MAX_ITERATIONS=6
XLH_RESEARCH_MAX_TOOL_CALLS=8

# All knowledge retrieval is backed by the official LightRAG v1.5.7 API. The advanced
# flag selects orchestration only; it does not enable a relational knowledge fallback.
XLH_ADVANCED_AI_ENABLED=false
XLH_LIGHTRAG_BASE_URL=http://127.0.0.1:9621
# Explicit local-only opt-in for the loopback HTTP endpoint above. Production uses HTTPS.
XLH_LIGHTRAG_ALLOW_INSECURE=true
XLH_LIGHTRAG_API_KEY=replace-with-a-distinct-private-key-of-32-plus-chars
# Fixed deployment contract: WORKSPACE=xiaolanhe_v1 and WORKING_DIR=/app/data/rag_storage.
XLH_LIGHTRAG_TIMEOUT=15s
XLH_LIGHTRAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_LIGHTRAG_LLM_API_KEY=replace-me
XLH_LIGHTRAG_LLM_MODEL=qwen3.5-flash
XLH_LIGHTRAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_LIGHTRAG_EMBEDDING_API_KEY=replace-me
XLH_LIGHTRAG_EMBEDDING_MODEL=text-embedding-v4
XLH_LIGHTRAG_EMBEDDING_DIM=1024
XLH_LIGHTRAG_EMBEDDING_SEND_DIM=false
XLH_LIGHTRAG_EMBEDDING_ASYMMETRIC=false
# Query/document prefixes are intentionally unset for this symmetric embedding contract.
XLH_LIGHTRAG_RERANK_BINDING=null
# Host-run application: replace this placeholder and use the exact same absolute path
# for the Compose bind source and the application verifier.
XLH_LIGHTRAG_REBUILD_FENCE_HOST_DIR=/absolute/path/to/XiaoLanHe/.state/lightrag-fence
XLH_LIGHTRAG_REBUILD_FENCE_DIR=/absolute/path/to/XiaoLanHe/.state/lightrag-fence
# For a non-root operator, the empty-bootstrap wrapper selects its nonzero primary
# group when this is empty. Root must explicitly set a dedicated nonzero group.
# Persist the printed value here for steady LightRAG and Go readers.
XLH_LIGHTRAG_SHARED_GID=
# Containerized application instead mounts the host directory read-only at
# /rebuild-fence and sets XLH_LIGHTRAG_REBUILD_FENCE_DIR=/rebuild-fence in the container.
XLH_LIGHTRAG_DEPLOYMENT_GENERATION=replace-with-versioned-generation
# Generated by: bash deploy/lightrag-bootstrap-empty.sh
XLH_LIGHTRAG_REBUILD_CONTRACT_SHA256=sha256:replace-with-64-lowercase-hex-characters
XLH_LIGHTRAG_IMAGE_DIGEST=sha256:5bdbd524931b011df246fe20888d110cef691e6804c12cde636a2b746d7de27e
XLH_LIGHTRAG_WORKING_DIR_ID=xlh-lightrag-data
XLH_EMBEDDING_ENDPOINT_PROFILE=dashscope-compatible-v1
XLH_LIGHTRAG_FIXTURE_SUITE_VERSION=lifecycle-v1
XLH_LEGACY_KNOWLEDGE=absent
XLH_MILVUS_MINIO_USER=replace-me
XLH_MILVUS_MINIO_PASSWORD=replace-me
# Milvus 2.6.11 authentication is always enabled. The server uses the root password
# as its initialization setting and only the bootstrap job receives a root token;
# steady-state LightRAG receives only this distinct database-scoped runtime token.
XLH_MILVUS_ROOT_PASSWORD=replace-with-a-distinct-milvus-root-password
XLH_MILVUS_TOKEN=xlh_lightrag:replace-with-a-distinct-runtime-password
# Required only for the one-time empty bootstrap and never for steady-state start.
XLH_LIGHTRAG_ATTEMPT_ID=replace-with-a-unique-bootstrap-attempt-id
XLH_LIGHTRAG_WRITER_EVIDENCE_HOST_DIR=/absolute/path/to/XiaoLanHe/.state/lightrag-writer-evidence
XLH_LIGHTRAG_UNCONTROLLED_WRITERS_ATTESTATION=no_uncontrolled_writers
XLH_ASSISTANT_TOTAL_TIMEOUT=45s
XLH_ASSISTANT_MAX_MODEL_CALLS=12
XLH_ASSISTANT_MAX_TOOL_CALLS=12
XLH_ASSISTANT_MAX_DELEGATIONS=3
XLH_COPILOT_MAX_ITERATIONS=4
XLH_PLANNING_TIMEOUT=15s
XLH_PLANNING_MAX_ITERATIONS=4
XLH_PLANNING_MAX_TOOL_CALLS=4
XLH_SUMMARY_TIMEOUT=10s
XLH_SUMMARY_THRESHOLD=12000
XLH_SUMMARY_CAP=2000
XLH_RECENT_MESSAGE_WINDOW=8
XLH_SUMMARY_PROMPT_VERSION=summary-v1

# Optional Redis + RocketMQ flash sale. Keep disabled unless all dependencies are provisioned.
XLH_FLASH_SALE_ENABLED=false
XLH_REDIS_PASSWORD=replace-me
XLH_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
# Local Compose only. Production must use rediss:// and keep this false.
XLH_REDIS_ALLOW_INSECURE=true
XLH_REDIS_KEY_PREFIX=xlh-local
XLH_FLASH_SALE_RECOVERY_GRACE=24h
XLH_ROCKETMQ_NAMESERVERS=127.0.0.1:9876
XLH_ROCKETMQ_ACCESS_KEY=
XLH_ROCKETMQ_SECRET_KEY=
# Local ACL-free Compose broker only. Production must configure both keys and keep this false.
XLH_ROCKETMQ_ALLOW_INSECURE=true
XLH_ROCKETMQ_TOPIC=XLH_FLASH_SALE_V1
XLH_ROCKETMQ_PRODUCER_GROUP=xlh-flash-sale-producer-v1
XLH_ROCKETMQ_CONSUMER_GROUP=xlh-flash-sale-consumer-v1
XLH_ROCKETMQ_SEND_TIMEOUT=3s
XLH_ROCKETMQ_CONSUME_TIMEOUT=30s
XLH_ROCKETMQ_CONSUMER_CONCURRENCY=16
XLH_ROCKETMQ_RETRY_LIMIT=16
XLH_FLASH_SALE_RECOVERY_INTERVAL=5s
XLH_FLASH_SALE_RECOVERY_STALE=30s
XLH_FLASH_SALE_RECOVERY_LEASE=30s
XLH_FLASH_SALE_RECOVERY_BATCH=100
XLH_FLASH_SALE_EXPIRY_INTERVAL=5s
XLH_FLASH_SALE_EXPIRY_BATCH=100
XLH_FLASH_SALE_RELEASE_INTERVAL=2s
XLH_FLASH_SALE_RELEASE_BATCH=100
XLH_FLASH_SALE_RELEASE_LEASE=30s
