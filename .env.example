XLH_DATABASE_URL=postgres://xlh:replace-me@127.0.0.1:5432/xiaolanhe?sslmode=disable
XLH_POSTGRES_PASSWORD=replace-me
XLH_AI_API_KEY=replace-me
XLH_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_AI_CHAT_MODEL=qwen3.5-flash
XLH_AI_EMBEDDING_MODEL=text-embedding-v4
XLH_PUBLIC_ORIGIN=http://localhost:5173
XLH_COOKIE_SECURE=false
# Required with advanced AI or flash sale; use a distinct 32+ character operator secret.
XLH_METRICS_TOKEN=replace-with-a-distinct-32-character-operator-secret
XLH_SEARCH_ENABLED=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
XLH_RESEARCH_TIMEOUT=25s
XLH_RESEARCH_TOOL_TIMEOUT=10s
XLH_RESEARCH_MAX_ITERATIONS=6
XLH_RESEARCH_MAX_TOOL_CALLS=8

# Advanced Assistant backed by the official LightRAG v1.5.7 API. Disabled by default.
XLH_ADVANCED_AI_ENABLED=false
XLH_LIGHTRAG_BASE_URL=http://127.0.0.1:9621
XLH_LIGHTRAG_API_KEY=replace-with-a-distinct-private-key-of-32-plus-chars
XLH_LIGHTRAG_WORKSPACE=xiaolanhe_v1
XLH_LIGHTRAG_WORKING_DIR=/app/data/rag_storage
XLH_LIGHTRAG_TIMEOUT=15s
XLH_LIGHTRAG_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_LIGHTRAG_LLM_API_KEY=replace-me
XLH_LIGHTRAG_LLM_MODEL=qwen3.5-flash
XLH_LIGHTRAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XLH_LIGHTRAG_EMBEDDING_API_KEY=replace-me
XLH_LIGHTRAG_EMBEDDING_MODEL=text-embedding-v4
XLH_LIGHTRAG_EMBEDDING_DIM=1024
XLH_LIGHTRAG_RERANK_BINDING=null
XLH_ASSISTANT_TOTAL_TIMEOUT=45s
XLH_ASSISTANT_MAX_MODEL_CALLS=12
XLH_ASSISTANT_MAX_TOOL_CALLS=12
XLH_ASSISTANT_MAX_DELEGATIONS=3
XLH_COPILOT_MAX_ITERATIONS=4
XLH_PLANNING_TIMEOUT=15s
XLH_PLANNING_MAX_ITERATIONS=4
XLH_PLANNING_MAX_TOOL_CALLS=4
XLH_SUMMARY_TIMEOUT=10s
XLH_SUMMARY_THRESHOLD=12000
XLH_SUMMARY_CAP=2000
XLH_RECENT_MESSAGE_WINDOW=8
XLH_SUMMARY_PROMPT_VERSION=summary-v1

# Optional Redis + RocketMQ flash sale. Keep disabled unless all dependencies are provisioned.
XLH_FLASH_SALE_ENABLED=false
XLH_REDIS_PASSWORD=replace-me
XLH_REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
XLH_REDIS_KEY_PREFIX=xlh-local
XLH_FLASH_SALE_RECOVERY_GRACE=24h
XLH_ROCKETMQ_NAMESERVERS=127.0.0.1:9876
XLH_ROCKETMQ_ACCESS_KEY=
XLH_ROCKETMQ_SECRET_KEY=
XLH_ROCKETMQ_TOPIC=XLH_FLASH_SALE_V1
XLH_ROCKETMQ_PRODUCER_GROUP=xlh-flash-sale-producer-v1
XLH_ROCKETMQ_CONSUMER_GROUP=xlh-flash-sale-consumer-v1
XLH_ROCKETMQ_SEND_TIMEOUT=3s
XLH_ROCKETMQ_CONSUME_TIMEOUT=30s
XLH_ROCKETMQ_CONSUMER_CONCURRENCY=16
XLH_ROCKETMQ_RETRY_LIMIT=16
XLH_FLASH_SALE_RECOVERY_INTERVAL=5s
XLH_FLASH_SALE_RECOVERY_STALE=30s
XLH_FLASH_SALE_RECOVERY_LEASE=30s
XLH_FLASH_SALE_RECOVERY_BATCH=100
XLH_FLASH_SALE_EXPIRY_INTERVAL=5s
XLH_FLASH_SALE_EXPIRY_BATCH=100
XLH_FLASH_SALE_RELEASE_INTERVAL=2s
XLH_FLASH_SALE_RELEASE_BATCH=100
XLH_FLASH_SALE_RELEASE_LEASE=30s
